<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />{% if seo_keywords %}
    <meta name="keywords" content="{{ seo_keywords }}, Cole Manning, Blog, RVRX, devblog, dev-blog, WPI, cmanning">{% else %}
    <meta name="keywords" content="Cole Manning, Blog, RVRX, devblog, dev-blog, WPI, cmanning">{% endif %}
{% include "seo.njk" %}

    <link href="/css/sidebar.css" rel="stylesheet">
    {% if "/posts/" in page.filePathStem %}<link href="/css/post.css" rel="stylesheet">
    <link href="/css/prism.css" rel="stylesheet">{% else %}<link href="/css/listing.css" rel="stylesheet">{% endif %}
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>code[class*="language-"]:not(pre code[class*="language-"]) {line-height: normal}</style> <!-- Override weird line-height from prisim-js -->
{% include "gtag.njk" %}
</head>
<body>
{% include "sidebar.njk" %}
{{ content | safe }}
</body>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init();
</script>
</html>










